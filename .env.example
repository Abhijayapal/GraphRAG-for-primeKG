# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ── Groq API (LLM for Chainlit UI) ──────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── API Server ───────────────────────────────────────────────────────────────
API_PORT=8000
LOG_LEVEL=INFO

# ── Embedding paths (relative to project root) ──────────────────────────────
ROTATE_EMBEDDINGS_PATH=embeddings/rotate_data/rotate_embeddings.npy
ROTATE_ENTITY_MAP_PATH=embeddings/rotate_data/rotate_entity_map.json
